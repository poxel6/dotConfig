#!/usr/bin/env bash

TMP_LOCATION="poxel6/scratch"
input="USER INPUT"

TMP_NAME=""
if [[ $# != 1 ]]; then
	read -p "[PROMPT]: Enter a name: " input
	TMP_NAME+="$input"
else
	TMP_NAME+="$1"
fi

# GPT MAGIC
# Split "zig-something" into:
#   LANG=zig
#   TMP_NAME=something
LANG="${TMP_NAME%%-*}"
TMP_NAME="${TMP_NAME#*-}"

echo "LANG: $LANG"
echo "TMP_NAME: $TMP_NAME"

TARGET="$HOME/$TMP_LOCATION/$LANG/$TMP_NAME"
echo "TARGET: $TARGET"

if [[ ! -d "$TARGET" ]]; then
	mkdir -p "$TARGET"
fi

$HOME/.local/share/bin/tmux-sessionizer "$TARGET"
