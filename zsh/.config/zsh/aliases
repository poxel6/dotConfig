alias srczsh='source $HOME/.zshrc'
alias srcbash='source $XDG_CONFIG_HOME/bash/bashrc'
alias tss='tmux-sessionizer'

alias yarn='yarn --use-yarnrc "$XDG_CONFIG_HOME/yarn/config"'
alias ff='fastfetch'
alias fff='fastfetch --config examples/10.jsonc  --logo ~/.config/fastfetch/arch-uwux.png --logo-preserve-aspect-ratio --logo-type kitty-icat --logo-width 40'

# Vim aliases
alias vi='nvim'
alias vim='nvim'

alias ls='eza -GAstype -F --icons=always'
alias ll='eza -hAlstype -F --icons=always'
alias lt='eza --tree -Astype -F --icons=never'

# Git aliases
alias gl='git log --all --graph --decorate --pretty=one'
alias gs='git status'
alias gd='git diff'
alias gc='git add -A && git commit'
alias gu='git push'
alias gp='git pull && git push'
alias gsync='git add -A || git commit -m "automatic commit" && git pull && git push'

alias nsync="git -C ~/notes add -A && ( ( git -C ~/notes commit -am $(date +%F_%H:%M:%S || true) ||  (git -C ~/notes pull && git -C ~/notes push) ) ||  (git -C ~/notes pull && git -C ~/notes push ))"
