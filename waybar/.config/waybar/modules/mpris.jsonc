{
	"mpris": {
		"format": "<span font_size='13000'>{player_icon}</span> {title}",
		"format-paused": "<span font_size='13000'>{status_icon}</span> <i>{title}</i>",
		"player-icons": {
			"default": "▶",
			"mpv": "🎵"
		},
		"status-icons": {
			"paused": "⏸"
		},
		"tooltip-format": "<span font_size='13000'>{player_icon}</span> {artist}: {title}",
		"ignored-players": ["brave"]
	}
}
