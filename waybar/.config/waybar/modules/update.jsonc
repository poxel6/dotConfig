{
	"custom/update": {
		"format": "<span font_size='13000'></span>  {}", // "<span font_size='13000'>󰮯</span>"
		"interval": 7200, // 2 hour = 2 * 60 * 60 => (hour) * (toMinutes) * (toSeconds)
		"exec-if": "[[ $(checkupdates) ]]",
		"exec": "num=$(checkupdates | wc -l) && notify-send '󰮯 \tPacman' \"$num\tpackage have update available.\"",
		"on-click": "kitty --app-id=custom-updater sh -c 'sudo pacman -Syu --noconfirm' && read",
		"tooltip": true,
		"tooltip-format": "packages have update available."
	}
}
