{
	"layer": "top",
	"position": "top",
	"mode": "dock",
	"height": 20,
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,
	"reload_style_on_change": true,
	"include": [
		"./modules/battery.jsonc",
		"./modules/memory.jsonc",
		"./modules/cpu.jsonc",
		"./modules/timer.jsonc",
		"./modules/update.jsonc",
		"./modules/wireplumber.jsonc",
		"./modules/notification.jsonc",
		"./modules/clock.jsonc",
		"./modules/idle_inhibitor.jsonc",
		"./modules/mpris.jsonc"
	],
	"modules-left": [
		"clock",
		"wireplumber",
		"mpris",
		"custom/update"
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"memory",
		"battery",
		"cpu",
		"custom/timer",
		"idle_inhibitor",
		"custom/notification",
		"tray"
	]
}
